# Required. Token used to read the PR diff and post the review comment.
# Locally: a fine-grained PAT with "Pull requests: read & write" on the target repo.
# In GitHub Actions this is provided automatically (github.token) — do not add it as a secret.
GITHUB_TOKEN=your_github_token

# Required. Groq API key (https://console.groq.com/keys).
# In GitHub Actions: Settings > Secrets and variables > Actions > New repository secret.
GROQ_API_KEY=your_groq_api_key

# Optional. Groq model id (default: openai/gpt-oss-120b).
GROQ_MODEL=openai/gpt-oss-120b

# Optional. Max response tokens per agent call (default: 1024).
GROQ_MAX_TOKENS=1024

# Optional. Max diff characters sent to the agents (default: 6000).
MAX_DIFF_CHARS=6000

# Optional. Logging level (default: INFO).
LOG_LEVEL=INFO
